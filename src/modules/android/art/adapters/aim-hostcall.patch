+/// Re-enter a fixed-signature guest function on the suspended guest stack.
+/// The caller retains the current JNI frame and all object references.
+///
+/// # Safety
+/// Only callable synchronously from a host call on this same guest thread;
+/// `function` is translated guest code with signature u64(u64).
+pub unsafe extern "C" fn call_guest(function: u64, argument: u64) -> u64 {
+    let ctx = current_ctx();
+    assert!(!ctx.is_null(), "guest callback without a guest thread");
+    unsafe {
+        assert!((*ctx).in_host != 0 && (*ctx).callback_sp != 0,
+                "guest callback outside a suspended host call");
+        linux_abi_call_guest(ctx, function, argument)
+    }
