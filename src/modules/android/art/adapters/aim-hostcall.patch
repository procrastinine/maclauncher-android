 //! registry, indexed by module id, with a retired id left empty.
 
 use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::OnceLock;
+
+type GuestCallback = unsafe extern "C" fn(u64, u64) -> u64;
+type ExtensionCall = unsafe extern "C" fn(u32, u64, u64, GuestCallback) -> i64;
+static EXTENSION: OnceLock<ExtensionCall> = OnceLock::new();
+const EXTENSION_ID: u32 = 0x4d4c;
+
+/// Install the explicitly selected MacLauncher JNI boundary before guest entry.
+/// The dylib remains resident for the process lifetime, like every host module.
+pub fn load_extension(path: &std::path::Path) -> Result<(), String> {
+    use std::os::unix::ffi::OsStrExt;
+    let path = std::ffi::CString::new(path.as_os_str().as_bytes()).map_err(|e| e.to_string())?;
+    unsafe {
+        let handle = libc::dlopen(path.as_ptr(), libc::RTLD_NOW | libc::RTLD_LOCAL);
+        if handle.is_null() { return Err(std::ffi::CStr::from_ptr(libc::dlerror()).to_string_lossy().into_owned()); }
+        let address = libc::dlsym(handle, c"maclauncher_art_host_call".as_ptr());
+        if address.is_null() {
+            let error = std::ffi::CStr::from_ptr(libc::dlerror()).to_string_lossy().into_owned();
+            libc::dlclose(handle); return Err(error);
+        }
+        let call: ExtensionCall = std::mem::transmute(address);
+        if EXTENSION.set(call).is_err() { libc::dlclose(handle); return Err("host module already installed".into()); }
+    }
+    Ok(())
+}
 
