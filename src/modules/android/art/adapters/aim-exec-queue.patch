+/// Hold descriptor admission until every temporary host-exec flag is restored.
+/// A failed native exec leaves the old image live, so another descriptor owner
+/// must not close or reuse a slot while its rollback still names that number.
+pub(super) struct HostExecAdmission {
+    cloexec: Option<super::exec_fd_receipt::HostExecFlags>,
+    writers: Option<super::fdtab::ExecWriterFlags>,
+    gate: Option<super::fdtab::Lifecycle>,
+}
+impl HostExecAdmission {
+    pub(super) fn new() -> Self {
+        Self { cloexec: None, writers: None, gate: Some(super::fdtab::lifecycle()) }
+    }
+    pub(super) fn retain(&mut self, receipt: Option<&super::exec_fd_receipt::Receipt>) -> Result<(), errno::Errno> {
+        self.writers = Some(super::fdtab::prepare_regular_exec()?);
+        self.cloexec = receipt.map(super::exec_fd_receipt::Receipt::retain_for_host_exec).transpose()?;
+        Ok(())
+    }
+}
+impl Drop for HostExecAdmission {
+    fn drop(&mut self) {
+        drop(self.cloexec.take());
+        drop(self.writers.take());
+        drop(self.gate.take());
+    }
+}
