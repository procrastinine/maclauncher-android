+// Darwin poll omits pipe EOF when its data direction was not requested.
+// Linux always returns HUP/ERR. This per-wait queue observes only those
+// terminal events on the same retained descriptors; it is no new fd owner.
+struct PipeEnds {queue:std::os::fd::OwnedFd,events:Vec<libc::kevent>}
+impl PipeEnds {
+ fn watch(fds:&[libc::pollfd])->Result<Option<Self>,i64>{
+  use std::os::fd::FromRawFd;
+  let mut changes=Vec::new();
+  for (index,p) in fds.iter().enumerate(){
+   if p.fd<0{continue;}
+   let mut stat:libc::stat=unsafe{std::mem::zeroed()};
+   if unsafe{libc::fstat(p.fd,&mut stat)}<0{return Err(-(errno::last()as i64));}
+   if stat.st_mode&libc::S_IFMT!=libc::S_IFIFO{continue;}
+   let flags=unsafe{libc::fcntl(p.fd,libc::F_GETFL)};if flags<0{return Err(-(errno::last()as i64));}
+   let read=flags&libc::O_ACCMODE==libc::O_RDONLY;
+   if (read&&p.events&(POLLIN|POLLRDNORM)!=0)||(!read&&p.events&(POLLOUT|libc::POLLWRNORM)!=0){continue;}
+   changes.push(libc::kevent{ident:p.fd as usize,filter:if read{libc::EVFILT_READ}else{libc::EVFILT_WRITE},flags:libc::EV_ADD|libc::EV_CLEAR,fflags:libc::NOTE_LOWAT,data:isize::MAX,udata:index as*mut libc::c_void});
+  }
+  if changes.is_empty(){return Ok(None);}
+  let raw=unsafe{libc::kqueue()};if raw<0{return Err(-(errno::last()as i64));}
+  let queue=unsafe{std::os::fd::OwnedFd::from_raw_fd(raw)};
+  if unsafe{libc::kevent(raw,changes.as_ptr(),changes.len()as i32,std::ptr::null_mut(),0,std::ptr::null())}<0{return Err(-(errno::last()as i64));}
+  Ok(Some(Self{queue,events:vec![unsafe{std::mem::zeroed()};changes.len()]}))
+ }
+ fn collect(&mut self,fds:&mut [libc::pollfd])->Result<(),i64>{
+  let zero=libc::timespec{tv_sec:0,tv_nsec:0};
+  let count=unsafe{libc::kevent(self.queue.as_raw_fd(),std::ptr::null(),0,self.events.as_mut_ptr(),self.events.len()as i32,&zero)};
+  if count<0{return Err(-(errno::last()as i64));}
+  for event in &self.events[..count as usize]{
+   if event.flags&libc::EV_ERROR!=0{return Err(-(event.data as i64));}
+   if event.flags&libc::EV_EOF!=0{fds[event.udata as usize].revents|=if event.filter==libc::EVFILT_READ{POLLHUP}else{POLLERR};}
+  }
+  Ok(())
+ }
