--- /dev/null
+++ b/crates/aim-host-gpu/src/opaque.rs
@@ -0,0 +1,85 @@
+//! RGBX window backing over ANGLE's existing RGB IOSurface attachment.
+//! ANGLE initializes alpha to one and masks subsequent alpha writes, so the
+//! default framebuffer has real opaque RGB semantics, not just config labels.
+
+use std::ffi::c_void;
+use aim_hostcall::gpu::OpaqueSurface;
+use crate::{EINVAL, display, metal, resolved};
+
+type Ref = *const c_void;
+
+aim_hostcall::dylib! {
+    static CF = c"/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation" {
+        static kCFTypeDictionaryKeyCallBacks: c_void;
+        static kCFTypeDictionaryValueCallBacks: c_void;
+        fn CFDictionaryCreateMutable(allocator: Ref, capacity: isize, keys: Ref, values: Ref) -> Ref;
+        fn CFDictionarySetValue(dictionary: Ref, key: Ref, value: Ref);
+        fn CFNumberCreate(allocator: Ref, kind: isize, value: Ref) -> Ref;
+        fn CFRelease(value: Ref);
+    }
+}
+aim_hostcall::dylib! {
+    static IOSURFACE = c"/System/Library/Frameworks/IOSurface.framework/IOSurface" {
+        static kIOSurfaceWidth: Ref;
+        static kIOSurfaceHeight: Ref;
+        static kIOSurfaceBytesPerElement: Ref;
+        static kIOSurfaceBytesPerRow: Ref;
+        static kIOSurfacePixelFormat: Ref;
+        fn IOSurfaceAlignProperty(key: Ref, value: usize) -> usize;
+        fn IOSurfaceCreate(properties: Ref) -> Ref;
+    }
+}
+
+pub fn create(a: &mut OpaqueSurface) -> i64 {
+    let address = resolved(c"eglCreatePbufferFromClientBuffer");
+    let query = resolved(c"eglGetConfigAttrib");
+    if address == 0 || query == 0 || a.width == 0 || a.height == 0 {
+        return EINVAL;
+    }
+    let pool = metal::pool_push();
+    // SAFETY: CF and EGL signatures below match the platform declarations;
+    // the dictionary retains values, and ANGLE retains a successful IOSurface.
+    unsafe {
+        let dictionary = CFDictionaryCreateMutable(std::ptr::null(), 5,
+            kCFTypeDictionaryKeyCallBacks().cast(), kCFTypeDictionaryValueCallBacks().cast());
+        let row = IOSurfaceAlignProperty(*kIOSurfaceBytesPerRow(), a.width as usize * 4);
+        for (key, value) in [
+            (*kIOSurfaceWidth(), a.width as i64),
+            (*kIOSurfaceHeight(), a.height as i64),
+            (*kIOSurfaceBytesPerElement(), 4),
+            (*kIOSurfaceBytesPerRow(), row as i64),
+            (*kIOSurfacePixelFormat(), 0x52474241), // 'RGBA' physical backing.
+        ] {
+            let number = CFNumberCreate(std::ptr::null(), 4, (&raw const value).cast());
+            CFDictionarySetValue(dictionary, key, number);
+            CFRelease(number);
+        }
+        let storage = IOSurfaceCreate(dictionary);
+        CFRelease(dictionary);
+        if storage.is_null() {
+            metal::pool_pop(pool);
+            return EINVAL;
+        }
+        let dpy = display::host(a.display as usize);
+        let get: unsafe extern "C" fn(usize, usize, i32, *mut i32) -> u32 = std::mem::transmute(query);
+        let mut target = 0;
+        if get(dpy, a.config as usize, 0x348d, &mut target) == 0 {
+            CFRelease(storage);
+            metal::pool_pop(pool);
+            return EINVAL;
+        }
+        let mut attributes = vec![
+            0x3057, a.width as i32, 0x3056, a.height as i32, // WIDTH, HEIGHT.
+            0x345a, 0, // IOSURFACE_PLANE_ANGLE.
+            0x3081, target, 0x3080, 0x305e, // TEXTURE_TARGET, TEXTURE_RGBA.
+            0x345c, 0x1401, 0x345d, 0x1907, // UNSIGNED_BYTE, RGB attachment.
+        ];
+        if a.colorspace != 0 { attributes.extend([0x309d, a.colorspace]); }
+        attributes.push(0x3038);
+        let create: unsafe extern "C" fn(usize, u32, Ref, usize, *const i32) -> usize = std::mem::transmute(address);
+        a.surface = create(dpy, 0x3454, storage, a.config as usize, attributes.as_ptr()) as u64;
+        CFRelease(storage);
+    }
+    metal::pool_pop(pool);
+    0
+}
diff --git a/hal/gles/src/configs.rs b/hal/gles/src/configs.rs
new file mode 100644
--- /dev/null
+++ b/hal/gles/src/configs.rs
@@ -0,0 +1,161 @@
+//! Android window config projection over the provider's real framebuffer types.
+//! Opaque RGBX aliases use an RGB IOSurface attachment; raw configs are retained.
+
+use super::*;
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+pub const CONFIG_ID: EGLint = 0x3028;
+const BUFFER_SIZE: EGLint = 0x3020;
+const SURFACE_TYPE: EGLint = 0x3033;
+const WINDOW: EGLint = 4;
+const PBUFFER: EGLint = 1;
+const DONT_CARE: EGLint = -1;
+pub const BAD_MATCH: EGLint = 0x3009;
+const BAD_CONFIG: EGLint = 0x3005;
+
+#[derive(Clone, Copy)]
+pub struct Opaque { display: usize, pub raw: usize, pub id: EGLint }
+
+fn aliases() -> &'static Mutex<HashMap<usize, Box<Opaque>>> {
+    static ALIASES: OnceLock<Mutex<HashMap<usize, Box<Opaque>>>> = OnceLock::new();
+    ALIASES.get_or_init(Default::default)
+}
+
+pub fn owner(config: EGLConfig) -> Option<Opaque> {
+    aliases().lock().unwrap().get(&(config as usize)).map(|x| **x)
+}
+pub fn raw(config: EGLConfig) -> EGLConfig {
+    owner(config).map_or(config, |o| o.raw as EGLConfig)
+}
+
+fn attribute(dpy: EGLDisplay, config: EGLConfig, name: EGLint) -> Option<EGLint> {
+    let mut value = 0;
+    // SAFETY: valid output storage and a provider config.
+    (unsafe { host::eglGetConfigAttrib(dpy, config, name, &mut value) } == EGL_TRUE).then_some(value)
+}
+
+fn list(dpy: EGLDisplay) -> Option<Vec<EGLConfig>> {
+    let mut count = 0;
+    // SAFETY: EGL allows a null array for a count query.
+    if unsafe { host::eglGetConfigs(dpy, std::ptr::null_mut(), 0, &mut count) } == EGL_FALSE {
+        return None;
+    }
+    let mut native = vec![std::ptr::null_mut(); count as usize];
+    // SAFETY: storage for all configs reported by this display.
+    if unsafe { host::eglGetConfigs(dpy, native.as_mut_ptr(), count, &mut count) } == EGL_FALSE {
+        return None;
+    }
+    native.truncate(count as usize);
+    let maximum = native.iter().filter_map(|&c| attribute(dpy, c, CONFIG_ID)).max().unwrap_or(0);
+    let mut result = Vec::with_capacity(native.len() * 2);
+    for (index, &config) in native.iter().enumerate() {
+        if [EGL_RED_SIZE, EGL_GREEN_SIZE, EGL_BLUE_SIZE, EGL_ALPHA_SIZE]
+            .iter().all(|&key| attribute(dpy, config, key) == Some(8))
+            && attribute(dpy, config, SURFACE_TYPE).is_some_and(|x| x & PBUFFER != 0)
+        {
+            let mut all = aliases().lock().unwrap();
+            let identity = match all.iter().find(|(_, x)| x.display == dpy as usize && x.raw == config as usize) {
+                Some((&identity, _)) => identity,
+                None => {
+                    let value = Box::new(Opaque { display: dpy as usize, raw: config as usize, id: maximum + index as i32 + 1 });
+                    let identity = (&*value as *const Opaque) as usize;
+                    all.insert(identity, value);
+                    identity
+                }
+            };
+            result.push(identity as EGLConfig);
+        }
+        result.push(config);
+    }
+    Some(result)
+}
+
+unsafe fn output(values: &[EGLConfig], out: *mut EGLConfig, size: EGLint, count: *mut EGLint) -> EGLBoolean {
+    // SAFETY: checked by callers; EGL output contract.
+    unsafe {
+        *count = if out.is_null() { values.len() } else { values.len().min(size as usize) } as EGLint;
+        if !out.is_null() { std::ptr::copy_nonoverlapping(values.as_ptr(), out, *count as usize); }
+    }
+    EGL_TRUE
+}
+
+pub unsafe fn get(dpy: EGLDisplay, out: *mut EGLConfig, size: EGLint, count: *mut EGLint) -> EGLBoolean {
+    if count.is_null() || size < 0 { return fail(EGL_BAD_PARAMETER, EGL_FALSE); }
+    match list(dpy) {
+        // SAFETY: EGL caller provides output storage.
+        Some(values) => unsafe { output(&values, out, size, count) },
+        None => EGL_FALSE,
+    }
+}
+
+pub unsafe fn query(dpy: EGLDisplay, config: EGLConfig, name: EGLint, value: *mut EGLint) -> EGLBoolean {
+    if value.is_null() { return fail(EGL_BAD_PARAMETER, EGL_FALSE); }
+    let projected = owner(config);
+    if projected.is_some_and(|x| x.display != dpy as usize) { return fail(BAD_CONFIG, EGL_FALSE); }
+    // SAFETY: validated output; pass through all provider attributes first.
+    let okay = unsafe { host::eglGetConfigAttrib(dpy, raw(config), name, value) };
+    if okay == EGL_FALSE { return okay; }
+    if let Some(o) = projected {
+        // SAFETY: output is non-null.
+        unsafe { match name {
+            EGL_ALPHA_SIZE => *value = 0,
+            BUFFER_SIZE => *value -= 8,
+            CONFIG_ID => *value = o.id,
+            SURFACE_TYPE => *value = WINDOW,
+            EGL_NATIVE_VISUAL_ID => *value = 2,
+            _ => {},
+        } }
+    }
+    okay
+}
+
+pub unsafe fn choose(dpy: EGLDisplay, attrs: *const EGLint, out: *mut EGLConfig, size: EGLint, count: *mut EGLint) -> EGLBoolean {
+    if count.is_null() || size < 0 { return fail(EGL_BAD_PARAMETER, EGL_FALSE); }
+    let Some(all) = list(dpy) else { return EGL_FALSE; };
+    let (mut requested, mut alpha, mut buffer, mut surface, mut visual) = (DONT_CARE, 0, 0, WINDOW, DONT_CARE);
+    let mut selected_owner = None;
+    let mut native_attrs = Vec::new();
+    let mut has_surface = false;
+    // SAFETY: EGL's terminated attribute-pair list.
+    unsafe {
+        let mut p = attrs;
+        while !p.is_null() && *p != EGL_NONE {
+            let (key, mut value) = (*p, *p.add(1));
+            p = p.add(2);
+            match key {
+                EGL_RECORDABLE_ANDROID | EGL_FRAMEBUFFER_TARGET_ANDROID => continue,
+                EGL_NATIVE_VISUAL_ID => { visual = value; continue; },
+                EGL_ALPHA_SIZE => alpha = value,
+                BUFFER_SIZE => buffer = value,
+                SURFACE_TYPE => { has_surface = true; surface = value; if value != DONT_CARE && value & WINDOW != 0 { value = (value & !WINDOW) | PBUFFER; } },
+                CONFIG_ID => {
+                    requested = value;
+                    selected_owner = all.iter().filter_map(|&c| owner(c)).find(|o| o.id == value);
+                    if let Some(o) = selected_owner { value = attribute(dpy, o.raw as EGLConfig, CONFIG_ID).unwrap_or(value); }
+                },
+                _ => {},
+            }
+            native_attrs.extend([key, value]);
+        }
+        if !has_surface { native_attrs.extend([SURFACE_TYPE, PBUFFER]); }
+        native_attrs.push(EGL_NONE);
+        let mut n = 0;
+        if host::eglChooseConfig(dpy, native_attrs.as_ptr(), std::ptr::null_mut(), 0, &mut n) == EGL_FALSE { return EGL_FALSE; }
+        let mut native = vec![std::ptr::null_mut(); n as usize];
+        if host::eglChooseConfig(dpy, native_attrs.as_ptr(), native.as_mut_ptr(), n, &mut n) == EGL_FALSE { return EGL_FALSE; }
+        native.truncate(n as usize);
+        let opaque_matches = selected_owner.is_some() || ((alpha == DONT_CARE || alpha == 0)
+            && (buffer == DONT_CARE || buffer <= 24)
+            && (surface == DONT_CARE || surface & !WINDOW == 0)
+            && (visual == DONT_CARE || visual == 2));
+        let mut result = Vec::new();
+        for config in native {
+            if opaque_matches {
+                if let Some(&alias) = all.iter().find(|&&c| owner(c).is_some_and(|o| o.raw == config as usize && (requested == DONT_CARE || requested == o.id))) { result.push(alias); }
+            }
